<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BocchiWallpaperPort</AssemblyName>
    <Product>孤独摇滚壁纸移植</Product>
    <Title>孤独摇滚壁纸移植</Title>
    <Description>孤独摇滚网页播放器的独立 Windows 桌面壁纸移植。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NikkiDesktop.Core\NikkiDesktop.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
